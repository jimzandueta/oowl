{
  "profile": "high",
  "description": "Quality-first profile for large or high-stakes projects. Premium frontier models (Qwen3.8 Max, Kimi K3, Grok 4.6) for all reasoning and implementation; cheap models only for routing and mechanical low-tier work.",
  "global": {
    "model": "opencode-go/minimax-m3",
    "small_model": "opencode/nemotron-3-ultra-free",
    "default_agent": "dispatcher"
  },
  "agent_order": [
    "dispatcher",
    "architect",
    "planner",
    "plan-reviewer",
    "builder",
    "reviewer",
    "designer",
    "frontend-engineer",
    "frontend-polisher",
    "backend-engineer",
    "database-engineer",
    "cloud-architect",
    "test-engineer",
    "code-reviewer",
    "security-reviewer",
    "security-auditor",
    "low-engineer",
    "low-task-worker",
    "low-architect",
    "low-designer",
    "high-engineer",
    "high-architect",
    "high-designer"
  ],
  "agents": {
    "dispatcher": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — routing and complete prompt framing."
    },
    "architect": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — architecture tradeoffs and design.md."
    },
    "planner": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — implementation planning and task decomposition."
    },
    "plan-reviewer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — strict plan validation and parallel-safety."
    },
    "builder": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — turns implementation.md into concrete task specs."
    },
    "reviewer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — verification summary and readiness."
    },
    "designer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — UI/UX design and ui-spec.md."
    },
    "frontend-engineer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — frontend implementation and complex logic."
    },
    "frontend-polisher": {
      "model": "opencode-go/qwen3.8-flash",
      "reason": "Cheap — mechanical visual and interaction polish."
    },
    "backend-engineer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — APIs, domain logic, and integrations."
    },
    "database-engineer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — schema design, migrations, and data integrity."
    },
    "cloud-architect": {
      "model": "opencode-go/grok-4.6",
      "reason": "Premium — infra design, IaC, and reliability."
    },
    "test-engineer": {
      "model": "opencode-go/kimi-k2.6",
      "reason": "Mid — test suite creation and coverage analysis."
    },
    "code-reviewer": {
      "model": "opencode-go/qwen3.8-max",
      "reason": "Premium — code correctness and architecture review."
    },
    "security-reviewer": {
      "model": "opencode-go/grok-4.6",
      "reason": "Premium — first-pass security review."
    },
    "security-auditor": {
      "model": "opencode-go/kimi-k3",
      "reason": "Best — deepest security analysis for production risk."
    },
    "low-engineer": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — non-sensitive bounded mechanical edits."
    },
    "low-task-worker": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — read/check/summarize only."
    },
    "low-architect": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — bounded architecture notes."
    },
    "low-designer": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — bounded design notes."
    },
    "high-engineer": {
      "model": "opencode-go/kimi-k3",
      "reason": "Best — escalation coding."
    },
    "high-architect": {
      "model": "opencode-go/kimi-k3",
      "reason": "Best — escalation architecture."
    },
    "high-designer": {
      "model": "opencode-go/kimi-k3",
      "reason": "Best — escalation design."
    }
  }
}
