{
  "profile": "high",
  "description": "Quality-first profile for high-stakes or shorter sessions. Uses Qwen3.7 Max for all implementation and review agents, GLM-5.1 for security audit. Flash only for routing and bounded low-tier tasks.",
  "global": {
    "model": "opencode-go/deepseek-v4-flash",
    "small_model": "opencode/nemotron-3-super-free",
    "default_agent": "dispatcher"
  },
  "agent_order": [
    "dispatcher",
    "architect",
    "planner",
    "plan-reviewer",
    "builder",
    "reviewer",
    "designer",
    "frontend-engineer",
    "frontend-polisher",
    "backend-engineer",
    "database-engineer",
    "cloud-architect",
    "test-engineer",
    "code-reviewer",
    "security-reviewer",
    "security-auditor",
    "low-engineer",
    "low-task-worker",
    "low-architect",
    "low-designer",
    "high-engineer",
    "high-architect",
    "high-designer"
  ],
  "agents": {
    "dispatcher": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — pure routing, no reasoning needed."
    },
    "architect": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — architecture tradeoffs and design.md."
    },
    "planner": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — implementation planning and task decomposition."
    },
    "plan-reviewer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — strict plan validation and parallel-safety."
    },
    "builder": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — scheduler only."
    },
    "reviewer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — verification summary and readiness."
    },
    "designer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — UI/UX design and ui-spec.md."
    },
    "frontend-engineer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — React, TypeScript, and complex frontend logic."
    },
    "frontend-polisher": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — high-polish UI and refined interactions."
    },
    "backend-engineer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — APIs, domain logic, and integrations."
    },
    "database-engineer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — schema design, migrations, data integrity."
    },
    "cloud-architect": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — infra, IaC, reliability, observability."
    },
    "test-engineer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — test suite creation and coverage analysis."
    },
    "code-reviewer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — code correctness and architecture review."
    },
    "security-reviewer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — first-pass security review."
    },
    "security-auditor": {
      "model": "opencode-go/glm-5.1",
      "reason": "Best — deepest security analysis for production risk."
    },
    "low-engineer": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — non-sensitive bounded tasks."
    },
    "low-task-worker": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — read/check/summarize only."
    },
    "low-architect": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — even low-tier architecture gets decent quality."
    },
    "low-designer": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — even low-tier design gets decent quality."
    },
    "high-engineer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — escalation coding."
    },
    "high-architect": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — escalation architecture."
    },
    "high-designer": {
      "model": "opencode-go/qwen3.7-max",
      "reason": "Premium — escalation design."
    }
  }
}
