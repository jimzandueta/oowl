{
  "$schema": "https://opencode.ai/config.json",

  // Profile-specific agent and command definitions live in .opencode/.
  // Global Task access is ask; only dispatcher receives an explicit Task allow-list.

  // Framework plugins: built-in methodology skills and compression mode.
  // Optional skills approved by `oowl init` are installed under .opencode/skills.
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "caveman@git+https://github.com/juliusbrussee/caveman.git"
  ],

  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode/nemotron-3-super-free",
  "default_agent": "dispatcher",

  "agent": {
    "designer": {
      "permission": {
        "skill": {
          "ui-ux-pro-max": "allow"
        }
      }
    },
    "high-designer": {
      "permission": {
        "skill": {
          "ui-ux-pro-max": "allow"
        }
      }
    },
    "architect": {
      "permission": {
        "skill": {
          "ui-ux-pro-max": "allow"
        }
      }
    }
  },

  "permission": {
    "*": "ask",

    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    // AGENTS.md is the workflow definition. No agent may edit, write, or delete it.
    "edit": {
      "*": "allow",
      "AGENTS.md": "deny"
    },
    "write": {
      "*": "allow",
      "AGENTS.md": "deny"
    },

    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "rm AGENTS.md": "deny",
      "rm -f AGENTS.md": "deny",
      "rm docs*": "deny",
      "rm -r docs*": "deny",
      "rm -rf docs*": "deny",
      "rm -fr docs*": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -rf .": "deny",
      "rm -fr .": "deny",
      "rm -rf ./*": "deny",
      "rm -fr ./*": "deny",
      "git clean*": "deny",
      "find * -delete*": "deny",
      "find * -exec*": "deny"
    },

    "skill": {
      "*": "allow"
    },

    "task": "ask",
    "todowrite": "allow",
    "lsp": "allow"
  },

  "instructions": [
    "prompts/workflow/dispatcher-routing.md",
    "prompts/review/plan-completeness.md",
    "prompts/review/security-review-checklist.md",
    "prompts/engineering/architecture-principles.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
