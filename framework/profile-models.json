{
  "profile": "low",
  "description": "Cost-first profile for long sessions and routine development. Uses Flash and Budget tiers for most agents, Mid and High only where production risk demands it.",
  "global": {
    "model": "opencode-go/deepseek-v4-flash",
    "small_model": "opencode/nemotron-3-super-free",
    "default_agent": "dispatcher"
  },
  "agent_order": [
    "dispatcher",
    "architect",
    "planner",
    "plan-reviewer",
    "builder",
    "reviewer",
    "designer",
    "frontend-engineer",
    "frontend-polisher",
    "backend-engineer",
    "database-engineer",
    "cloud-architect",
    "test-engineer",
    "code-reviewer",
    "security-reviewer",
    "security-auditor",
    "low-engineer",
    "low-task-worker",
    "low-architect",
    "low-designer",
    "high-engineer",
    "high-architect",
    "high-designer"
  ],
  "agents": {
    "dispatcher": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — pure routing, no reasoning needed."
    },
    "architect": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — sufficient for design exploration and tradeoffs."
    },
    "planner": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — task decomposition and dependency ordering."
    },
    "plan-reviewer": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — validation, file lock overlap checking."
    },
    "builder": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — scheduler only, no implementation."
    },
    "reviewer": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — review coordination and verification summary."
    },
    "designer": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — UI/UX design and ui-spec.md."
    },
    "frontend-engineer": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — implementation, debugging, tests."
    },
    "frontend-polisher": {
      "model": "opencode-go/minimax-m2.5",
      "reason": "Cheapest — visual tweaks, interaction polish."
    },
    "backend-engineer": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — APIs, domain logic, integrations."
    },
    "database-engineer": {
      "model": "opencode-go/qwen3.6-plus",
      "reason": "Mid — schema design and data integrity need broader context."
    },
    "cloud-architect": {
      "model": "opencode-go/qwen3.6-plus",
      "reason": "Mid — infra design, IaC, reliability decisions."
    },
    "test-engineer": {
      "model": "opencode-go/mimo-v2.5",
      "reason": "Cheapest — test creation and coverage analysis."
    },
    "code-reviewer": {
      "model": "opencode-go/minimax-m2.7",
      "reason": "Low-mid — code correctness and maintainability."
    },
    "security-reviewer": {
      "model": "opencode-go/glm-5",
      "reason": "Mid — first-pass security analysis needs quality."
    },
    "security-auditor": {
      "model": "opencode-go/glm-5.1",
      "reason": "High — production risk decisions need strongest model."
    },
    "low-engineer": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — non-sensitive bounded tasks."
    },
    "low-task-worker": {
      "model": "opencode-go/deepseek-v4-flash",
      "reason": "Cheapest — read/check/summarize only."
    },
    "low-architect": {
      "model": "opencode-go/mimo-v2.5",
      "reason": "Cheapest — bounded non-sensitive architecture reasoning."
    },
    "low-designer": {
      "model": "opencode-go/mimo-v2.5",
      "reason": "Cheapest — bounded non-sensitive design work."
    },
    "high-engineer": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — escalation coding needs better reasoning."
    },
    "high-architect": {
      "model": "opencode-go/glm-5.1",
      "reason": "High — escalation architecture and risk decisions."
    },
    "high-designer": {
      "model": "opencode-go/minimax-m3",
      "reason": "Mid — escalation design needs better quality."
    }
  }
}
